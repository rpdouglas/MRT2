rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Checks if the authenticated user's ID matches the requested ID
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Checks if the document being accessed belongs to the user (for existing docs)
    function isResourceOwner() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Checks if the document being created is tagged with the user's ID
    function isCreatingOwnedResource() {
      return request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Checks for Custom Claim 'admin'
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles & Subcollections
    match /users/{userId} {
      // Profile Document
      allow read: if isOwner(userId) || isAdmin();

      // Account creation: the client writes its own initial profile on first
      // login (see getOrCreateUserProfile in src/lib/db.ts). tier/role must
      // start at their safe defaults so a crafted first write can't self-grant
      // premium or admin.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.tier == 'free' &&
        request.resource.data.role == 'user'
      );

      // Profile updates: owners may edit their own document, but never the
      // billing tier or role fields — tier/tierSource are exclusively written
      // by syncStripeSubscription (Cloud Function, admin SDK), and role is
      // admin-managed. This prevents client-side self-escalation to Premium
      // or to the admin UI (AuthContext.tsx trusts profile.role === 'admin').
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'tierSource', 'role'])
      );

      allow delete: if isOwner(userId) || isAdmin();

      // Safe Subcollections (User Managed)
      match /workbook_answers/{answerId} {
        allow read, write: if isOwner(userId);
      }
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
      match /rosc_assessments/{assessmentId} {
        allow read, write: if isOwner(userId);
      }

      // Stripe Extension Subcollections (Backend Managed)
      // Users create the session request, backend fills in the URL.
      match /checkout_sessions/{id} {
        allow create, read: if isOwner(userId);
        allow update, delete: if false; 
      }
      // Users can read their status, but CANNOT fake a subscription.
      match /subscriptions/{id} {
        allow read: if isOwner(userId);
        allow write: if false; 
      }
      match /payments/{id} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // 2. Journals (Root Collection)
    match /journals/{entryId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isResourceOwner();
    }

    // 3. Tasks (Root Collection)
    match /tasks/{taskId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isResourceOwner();
    }

    // 4. Insights / Wisdom Log (Root Collection)
    match /insights/{insightId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isResourceOwner();
    }

    // 5. AI Analytics Logs
    match /ai_logs/{logId} {
      allow create: if isCreatingOwnedResource();
      allow read: if isAdmin();
    }

    // 6. Client Error Logs
    match /client_errors/{errorId} {
      allow create: if isCreatingOwnedResource();
      allow read, delete: if isAdmin();
    }
    
    // 7. Service (The Lisa Module - Placeholder for PROJ-05)
    match /service/{serviceId} {
        allow create: if isCreatingOwnedResource();
        allow read, update, delete: if isResourceOwner();
    }

    // 8. Feedback & Bug Reports
    match /feedback/{reportId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isAdmin();
    }

    // 9. Daily Reading Preferences (PROJ-42)
    match /user_reading_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 10. Daily Readings — admin-seeded content, readable by all authenticated users
    match /daily_readings/{readingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
