rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Checks if the authenticated user's ID matches the requested ID
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Checks if the document being accessed belongs to the user (for existing docs)
    function isResourceOwner() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Checks if the document being created is tagged with the user's ID
    function isCreatingOwnedResource() {
      return request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // Checks for Custom Claim 'admin'.
    // PROJ-115: found via a real emulator test (not previously exercised —
    // every prior rules test only did single-doc get/set/update/delete, none
    // did a list/query) that `request.auth.token.admin` throws
    // "Property admin is undefined" for a non-admin's *list* request,
    // instead of evaluating to false like a plain `get` does — a regular
    // user's token has no `admin` key at all, and direct property access on
    // an absent map key errors rather than short-circuiting. `.get(key,
    // default)` never throws regardless of get/list context, which is why
    // this was silently swallowed for years: executeTotalAccountAnnihilation
    // list-queries ai_logs/feedback (etc.) as the non-admin owner, but wraps
    // each scan in try/catch — so the permission-denied error was caught and
    // warned, not surfaced, meaning those collections were never even
    // discovered for deletion, let alone deleted.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // --- SHAPE/SIZE VALIDATION (PROJ-99 Phase 1) ---
    // Ownership rules alone don't stop an authenticated owner from writing an
    // arbitrarily large or malformed document — these close that gap for the
    // two highest-payload collections. Split into shape (types/required
    // fields) vs. size (byte ceiling) because they carry different risk on
    // the update path: shape is safe to enforce on every write, since any
    // document that already exists was written by client code that always
    // set these fields with these types (JournalEntry/GameSaveRecord in
    // src/lib/db.ts) — enforcing it server-side changes nothing for existing
    // data. Size is enforced on create only: a pre-existing document written
    // before this rule shipped could already exceed today's chosen ceiling
    // (no production byte-size telemetry exists to rule that out), and nothing
    // — PIN rotation re-encrypting old entries, a user editing an old entry —
    // should be able to retroactively lock out access to their own past data.
    // Ceilings are deliberately generous, well under Firestore's 1MiB
    // per-document hard limit; the goal is bounding "unbounded", not tuning
    // a byte count. .size() on a string is UTF-8 byte length, matching how
    // Firestore's own document-size limit is measured.
    function isValidJournalShape() {
      return request.resource.data.uid is string &&
             request.resource.data.content is string &&
             request.resource.data.createdAt is timestamp;
    }

    function isValidJournalSize() {
      return request.resource.data.content.size() < 51200; // 50KB
    }

    function isValidGameSaveShape() {
      return request.resource.data.uid is string &&
             request.resource.data.gameId is string &&
             request.resource.data.encryptedState is string &&
             request.resource.data.updatedAt is timestamp;
    }

    function isValidGameSaveSize() {
      return request.resource.data.encryptedState.size() < 204800; // 200KB
    }

    // PROJ-111 (MAT Dose-Tracking) — mirrors isValidJournalShape/Size above,
    // but encryptedNote is optional (a bare dose log with no note is valid).
    function isValidMatDoseShape() {
      return request.resource.data.uid is string &&
             request.resource.data.loggedAt is timestamp &&
             request.resource.data.date is string;
    }

    function isValidMatDoseSize() {
      return !('encryptedNote' in request.resource.data) ||
             request.resource.data.encryptedNote.size() < 10240; // 10KB — short note, not a journal entry
    }

    // --- COLLECTION RULES ---

    // 1. User Profiles & Subcollections
    match /users/{userId} {
      // Profile Document
      allow read: if isOwner(userId) || isAdmin();

      // Account creation: the client writes its own initial profile on first
      // login (see getOrCreateUserProfile in src/lib/db.ts). tier/role must
      // start at their safe defaults so a crafted first write can't self-grant
      // premium or admin.
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.tier == 'free' &&
        request.resource.data.role == 'user'
      );

      // Profile updates: owners may edit their own document, but never the
      // billing tier or role fields — tier/tierSource are exclusively written
      // by syncStripeSubscription (Cloud Function, admin SDK), and role is
      // admin-managed. This prevents client-side self-escalation to Premium
      // or to the admin UI (AuthContext.tsx trusts profile.role === 'admin').
      // pinAttempts is likewise server-write-only (verifyVaultPin, PROJ-65) —
      // a client that could reset/forge its own lockout state would defeat
      // the vault-PIN brute-force rate limiter entirely. lastWorkbookCoachCall
      // (PROJ-106) is the same story for the all-tier workbook_coach floor —
      // unlike usage_limits.*, nothing client-side legitimately writes this
      // field, so it can be fully server-write-only without breaking anything.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'tierSource', 'role', 'pinAttempts', 'lastWorkbookCoachCall'])
      );

      allow delete: if isOwner(userId) || isAdmin();

      // Safe Subcollections (User Managed)
      match /workbook_answers/{answerId} {
        allow read, write: if isOwner(userId);
      }
      match /templates/{templateId} {
        allow read, write: if isOwner(userId);
      }
      match /rosc_assessments/{assessmentId} {
        allow read, write: if isOwner(userId);
      }

      // Stripe Extension Subcollections (Backend Managed)
      // Users create the session request, backend fills in the URL.
      match /checkout_sessions/{id} {
        allow create, read: if isOwner(userId);
        allow update, delete: if false; 
      }
      // Users can read their status, but CANNOT fake a subscription.
      match /subscriptions/{id} {
        allow read: if isOwner(userId);
        allow write: if false; 
      }
      match /payments/{id} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // PROJ-105: Google Play Billing purchase records (TWA-only path,
      // parallel to the Stripe subcollections above). The client creates the
      // doc right after a Digital Goods API purchase completes, so the
      // purchaseToken survives an app close before verification finishes —
      // but it can never mark itself verified or set its own status/tier;
      // only verifyPlayPurchase (Cloud Function, admin SDK) and the RTDN
      // handler can do that, matching checkout_sessions' create-then-backend-
      // completes shape rather than subscriptions' fully-locked one.
      match /playPurchases/{token} {
        allow create, read: if isOwner(userId);
        allow update, delete: if false;
      }
    }

    // 1b. Play Billing purchase-token → uid lookup (Root Collection, PROJ-105)
    // The RTDN Pub/Sub handler (functions/src/index.ts) receives renewal/
    // cancellation notifications from Google containing only a purchaseToken
    // — no uid — so it needs a way to find the owning user without a
    // collection-group index. The client writes this single-field pointer
    // doc at purchase time (same moment it writes users/{uid}/playPurchases/
    // {token} above); nothing ever reads it back client-side, and nothing
    // but the doc's own owner can even create it.
    match /playPurchaseIndex/{token} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if false;
    }

    // 2. Journals (Root Collection)
    match /journals/{entryId} {
      allow create: if isCreatingOwnedResource() && isValidJournalShape() && isValidJournalSize();
      allow read, delete: if isResourceOwner();
      allow update: if isResourceOwner() && isValidJournalShape();
    }

    // 3. Tasks (Root Collection)
    match /tasks/{taskId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isResourceOwner();
    }

    // 3b. MAT Dose Logs (Root Collection, PROJ-111)
    match /mat_doses/{doseId} {
      allow create: if isCreatingOwnedResource() && isValidMatDoseShape() && isValidMatDoseSize();
      allow read, delete: if isResourceOwner();
      allow update: if isResourceOwner() && isValidMatDoseShape() && isValidMatDoseSize();
    }

    // 4. Insights / Wisdom Log (Root Collection)
    match /insights/{insightId} {
      allow create: if isCreatingOwnedResource();
      allow read, update, delete: if isResourceOwner();
    }

    // 5. AI Analytics Logs
    // PROJ-115: added owner-delete so a user can actually purge their own
    // account — previously had no delete rule at all (default deny for
    // everyone, including admin), which silently broke account deletion for
    // any user who'd ever used an AI feature. Owner-read (get+list) is
    // ALSO required, not just delete: executeTotalAccountAnnihilation finds
    // its own docs via a `where('uid','==',uid)` list query, and Firestore
    // has no way to delete-by-filter without first being allowed to list —
    // discovered by a real emulator test denying the list itself even after
    // delete was fixed. isResourceOwner()-scoped list access is the same
    // proven pattern every other user-data collection here already uses
    // (journals, tasks, game_progress, ...) — it only ever exposes a user's
    // own documents, never another user's.
    match /ai_logs/{logId} {
      allow create: if isCreatingOwnedResource();
      allow read, delete: if isAdmin() || isResourceOwner();
    }

    // 6. Client Error Logs
    // PROJ-115: same fix as ai_logs above.
    match /client_errors/{errorId} {
      allow create: if isCreatingOwnedResource();
      allow read, delete: if isAdmin() || isResourceOwner();
    }
    
    // 7. Service (The Lisa Module - Placeholder for PROJ-05)
    match /service/{serviceId} {
        allow create: if isCreatingOwnedResource();
        allow read, update, delete: if isResourceOwner();
    }

    // 7b. Recovery Games — encrypted game_progress (PROJ-72, Phase 1)
    match /game_progress/{progressId} {
        allow create: if isCreatingOwnedResource();
        allow read, update, delete: if isResourceOwner();
    }

    // 7c. Recovery Games — encrypted, resumable game_saves (PROJ-72, Phase 4)
    match /game_saves/{saveId} {
        allow create: if isCreatingOwnedResource() && isValidGameSaveShape() && isValidGameSaveSize();
        allow read, delete: if isResourceOwner();
        allow update: if isResourceOwner() && isValidGameSaveShape();
    }

    // 8. Feedback & Bug Reports
    // PROJ-115: same fix as ai_logs/client_errors above — delete (and the
    // owner-read a list-based delete requires, see ai_logs' comment) were
    // admin-only, silently breaking account deletion for any user who'd ever
    // submitted feedback. `update` stays admin-only — responding to/managing
    // reports is an admin workflow this ticket doesn't touch.
    match /feedback/{reportId} {
      allow create: if isCreatingOwnedResource();
      allow read, delete: if isAdmin() || isResourceOwner();
      allow update: if isAdmin();
    }

    // 9. Daily Reading Preferences (PROJ-42)
    match /user_reading_preferences/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 10. Daily Readings — admin-seeded content, readable by all authenticated users
    match /daily_readings/{readingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 11. Daily Crossword — nightly-generated content (PROJ-79), one shared
    // puzzle per calendar date, same read-any/write-admin-only shape as
    // Daily Readings. No user data in this collection — see
    // docs/projects/79_DAILY_CROSSWORD.md §2.
    match /crossword_puzzles/{date} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 12. Buffer Status (PROJ-42) — Cloud-Function/Admin-SDK-only tracker of
    // reading-buffer generation state (checkBufferHealth/generateReadingBatch).
    // Never read or written from the client; explicit default-deny per
    // docs/SCHEMA_ARCHITECTURE.md's buffer_status/{modality} entry.
    match /buffer_status/{modality} {
      allow read, write: if false;
    }

    // 13. Image Library (PROJ-113) — admin-uploaded inspirational image
    // metadata (Storage path/URL, caption, rotation bookkeeping). Not user
    // data — same read-any-authenticated/write-admin-only shape as
    // Daily Readings/Daily Crossword above. See
    // docs/projects/113_DAILY_INSPIRATIONAL_IMAGE.md §2/§3.
    match /image_library/{imageId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 14. Daily Images (PROJ-113) — nightly-assigned "today's image" record,
    // one shared doc per calendar date, same shape/rationale as
    // crossword_puzzles above.
    match /daily_images/{date} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
