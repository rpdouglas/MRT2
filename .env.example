# PROJ-105: Google Play Console subscription product ID for the Android TWA
# Play Billing path (Digital Goods API). Created once in Play Console >
# Monetize > Products > Subscriptions — e.g. "premium.monthly". Unset means
# the Play Billing purchase button in PremiumUpgrade.tsx shows an error
# instead of launching a purchase; it does not affect the Stripe path.
VITE_PLAY_BILLING_PRODUCT_ID=placeholder_replace_me

# PROJ-103: Firebase App Check (reCAPTCHA v3 site key). Optional — if unset,
# App Check simply isn't initialized (no tokens attached, no behavior change).
# Get this from Firebase Console > Project Settings > App Check once the app
# is registered there. See docs/projects/103_FIREBASE_APP_CHECK.md.
VITE_RECAPTCHA_SITE_KEY=
