{
  "name": "mrt2",
  "private": true,
  "version": "1.9.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "npm run build --prefix functions && concurrently -n vite,emulators -c blue,yellow \"vite\" \"firebase emulators:start --only auth,firestore,functions --project=mrt2-app-dev\"",
    "seed:crossword": "node scripts/seed-crossword-emulator.cjs",
    "prebuild": "node scripts/generate-build-info.js",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:check-specs": "node scripts/check_spec_quality.mjs",
    "test:once": "vitest run",
    "test:e2e": "npm run build --prefix functions && firebase emulators:exec --project=mrt2-app-dev --only auth,firestore,functions \"playwright test\"",
    "test:e2e:security": "playwright test --config=playwright.security.config.ts",
    "test:rules": "firebase emulators:exec --project=mrt2-app-dev --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "check": "npm run lint && npm run docs:check-specs && npm run test:once && npm run build",
    "export:llm": "node scripts/export-llm.mjs",
    "screenshots:generate": "node scripts/generate_screenshots.js",
    "deadcode": "knip"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@posthog/react": "^1.10.3",
    "@tanstack/react-query": "^5.66.0",
    "date-fns": "^4.1.0",
    "firebase": "^12.11.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.2",
    "posthog-js": "^1.399.1",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.10.1",
    "react-virtuoso": "^4.12.5",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "web-vitals": "^6.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google/generative-ai": "^0.24.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.24.0",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "knip": "^6.26.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^6.0.11",
    "tailwindcss": "3.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
